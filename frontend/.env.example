# Backend base URL for API requests.
# Leave empty for local dev (Vite proxies /api to the backend) and when the
# backend serves the frontend on the same origin.
# On a split deploy (frontend on Vercel), set this to the backend URL:
#   VITE_API_URL=https://your-app.up.railway.app
VITE_API_URL=

# Dev only: an admin session token so /admin opens in `pnpm dev` without a Telegram login.
# Mint it from backend/ (OPS_ADMIN_IDS must contain your Telegram id):
#   uv run python -c "from app.core import admin_auth; print(admin_auth.issue_session_token(<your id>)[0])"
# Ignored by `pnpm build`.
VITE_ADMIN_TOKEN=
