# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN
BOT_USERNAME=YOUR_BOT_USERNAME
# polling for local development, webhook for production (requires public WEBHOOK_BASE_URL)
BOT_MODE=polling
WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App frontend (Vercel domain; ngrok URL for local Telegram testing)
MINI_APP_URL=
# Public HTTPS URL of the backend (Railway domain), used for the Telegram webhook
WEBHOOK_BASE_URL=
# Extra browser origins allowed by CORS (CSV), in addition to MINI_APP_URL.
# Set to the Vercel frontend origin when frontend and backend are deployed separately.
CORS_ORIGINS=

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2500

# Local RAG corpora. Basic access is useful only for development/testing.
RAG_ENABLED=true
RAG_ALLOW_BASIC=false
PRO_PRICE_STARS=350
FREE_DAILY_QUESTIONS=3
TRIAL_DAYS=7
TRIAL_DAILY_RAG_QUESTIONS=5
TRIAL_TOTAL_RAG_QUESTIONS=35
PRO_DAILY_RAG_QUESTIONS=30
PRO_DAILY_COUNCIL_QUESTIONS=3
RAG_DATA_DIR=data/rag
RAG_TOP_K=4
# Semantic retrieval: embeddings are stored in the rag_chunks table by scripts/embed_rag.py.
# Changing the model or dimension requires re-running that script with --force.
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIM=768

# Storage (these values match docker-compose services)
DATABASE_URL=postgresql+asyncpg://aeon:aeon@postgres:5432/aeon

# Daily agent notifications
REMINDER_HOUR=9
REMINDER_TZ=UTC

# Product-owner notifications (optional). Add the bot to a Telegram group and put its id
# (negative, e.g. -1001234567890) here; leave 0 to disable pushes and digests.
OPS_CHAT_ID=0
# Forum topic ids inside the group for sales / alerts / digests; 0 posts to the general chat.
OPS_THREAD_SALES=0
OPS_THREAD_ALERTS=0
OPS_THREAD_DIGESTS=0
# Telegram user ids (CSV) allowed to run /stats in a private chat with the bot.
OPS_ADMIN_IDS=
# Local hour for daily/weekly/monthly digests; OPS_TZ falls back to REMINDER_TZ.
OPS_DIGEST_HOUR=9
OPS_TZ=
# Admin panel (/admin on the frontend). Empty secret derives a key from BOT_TOKEN.
ADMIN_SESSION_SECRET=
# Browser sign-in through Telegram OAuth (OIDC). @BotFather -> Bot Settings -> Web Login
# issues the client id (the bot id) and secret, and takes the allowed redirect URL.
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
# Defaults to <MINI_APP_URL>/admin/callback; must match a Web Login allowed URL.
ADMIN_OAUTH_REDIRECT_URI=
